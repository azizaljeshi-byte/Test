+GROUP_MAX_LINES = 40
+_GROUPS = (("EXIT", "\U0001F534", "EXIT: sell or trim"), ("AVOID", "\U0001F534", "AVOID"), ("ON THE LINE", "\U0001F7E0", "ON THE LINE: no new buys"),
+           ("WAIT FOR TURN", "\U0001F7E1", "WAIT FOR TURN"), ("HOLD", "\U0001F535", "HOLD"), ("WAIT", "\U0001F7E1", "WAIT"),
+           ("ADD", "\U0001F7E2", "ADD"), ("BUY", "\U0001F7E2", "BUY"))
+
+
+def _pct(v) -> str:
+    return f"{v * 100:+.1f}%".replace("-", "\u2212") if isinstance(v, (int, float)) and v == v else ""
+
+
+def grouped_lines(items: list[dict]) -> list[str]:
+    """A readable body for many call changes at once: one block per new call, most urgent first, one stock per line.
+    Sell calls show the day's move and the close against the exit line; the quiet calls are just the tickers and what each was.
+    items: {"t", "before", "call", "close", "line", "dc", "vr"}. Display only."""
+    out: list[str] = []
+    known = [g[0] for g in _GROUPS]
+    for call, dot, head in _GROUPS + (("", "\u26AA", "OTHER"),):
+        grp = [i for i in items if (i["call"] == call if call else i["call"] not in known)]
+        if not grp:
+            continue
+        if out:
+            out.append("")
+        out.append(f"{dot} {head} ({len(grp)})")
+        if call in SELL_CALLS:
+            for i in sorted(grp, key=lambda x: x["dc"] if isinstance(x.get("dc"), (int, float)) else 0):
+                vol = f" on {i['vr']:.0f}x volume" if isinstance(i.get("vr"), (int, float)) and i["vr"] >= 2 and isinstance(i.get("dc"), (int, float)) and i["dc"] <= -0.03 else ""
+                line = f"{i['t']}  {_pct(i.get('dc'))}{vol}".rstrip()
+                if isinstance(i.get("close"), (int, float)) and isinstance(i.get("line"), (int, float)):
+                    line += f" \u00b7 closed {i['close']:,.2f}, exit line {i['line']:,.2f}"
+                out.append(line)
+        else:
+            out.append(", ".join(f"{i['t']} (was {i['before'].lower()})" if len({x['before'] for x in grp}) > 1 else i["t"] for i in grp)
+                       + ("" if len({x["before"] for x in grp}) > 1 else f"  (was {grp[0]['before'].lower()})"))
+    return out
+
+
+def grouped_title(n: int, items: list[dict], what: str = "of your stocks changed") -> str:
+    bits = []
+    for call, _d, _h in _GROUPS:
+        k = sum(1 for i in items if i["call"] == call)
+        if k:
+            bits.append(f"{k} {call.lower()}")
+    return f"{n} {what}: " + ", ".join(bits[:4]) if bits else f"{n} {what}"
+
